# Copy to .env (ignored by git). docker compose reads it automatically; for a local manage.py, export the lines.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CATEGORISER_PROVIDER=auto      # auto: Gemini when a key is set, otherwise the fallback. Or: gemini | none | fake
CATEGORISER_TIMEOUT_SECONDS=10
REVIEW_THRESHOLD=0.6
SECRET_KEY=change-me
DEBUG=0
